// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 고객 정보 (기능 01, 02, 03, 05)
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  title     String?
  email     String   @unique
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduledMails ScheduledMail[]
  mailLogs       MailLog[]
}

// 예약 메일 (기능 10, 11)
model ScheduledMail {
  id          Int       @id @default(autoincrement())
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  toEmail     String
  subject     String
  body        String
  scheduledAt DateTime
  status      String    @default("PENDING") // PENDING | SENT | CANCELLED | FAILED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// 발송 기록 (기능 12)
model MailLog {
  id           Int       @id @default(autoincrement())
  customerId   Int?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  toEmail      String
  subject      String
  body         String
  sentAt       DateTime  @default(now())
  status       String    @default("SUCCESS") // SUCCESS | FAILED
  errorMessage String?
}

// SMTP 설정 (기능 09) - 단일 설정 레코드
model SmtpConfig {
  id        Int      @id @default(autoincrement())
  email     String
  password  String // Google App Password
  host      String   @default("smtp.gmail.com")
  port      Int      @default(587)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
